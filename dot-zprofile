function safe_ensure_path {
	if [[ -d "$1" && ${path[(ie)"$1"]} > ${#path} ]]; then
	    export PATH="$1:$PATH"
	fi
}

function safe_source {
	test -s "$1" && . "$1"
}

safe_ensure_path "$HOME/bin";
safe_ensure_path "$HOME/.local/bin";

export VCPKG_ROOT="$HOME/.local/src/vcpkg/current"

safe_source "$HOME/.cargo/env"
safe_ensure_path "$HOME/go/bin"
safe_source "$HOME/.deno/env"

if (( $+commands[luarocks] )); then
	eval "$(luarocks path)"
fi
